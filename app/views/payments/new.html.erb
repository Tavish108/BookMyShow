<div class="min-h-screen bg-gray-950 text-white">

  <!-- Navbar -->
  <nav class="border-b border-gray-800 bg-gray-900">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">

      <%= link_to "BookMyShow",
          root_path,
          class: "text-2xl font-bold tracking-tight text-red-500 hover:text-red-400 transition" %>

      <div class="flex items-center gap-4">

        <span class="hidden text-sm text-gray-400 sm:block">
          Hi,
          <span class="font-medium text-white">
            <%= current_user.name %>
          </span>
        </span>

        <%= link_to "My Profile",
            me_path,
            class: "rounded-lg px-4 py-2 text-sm font-medium text-gray-300 transition hover:bg-gray-800 hover:text-white" %>

        <%= button_to "Logout",
            logout_path,
            method: :delete,
            class: "rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-700" %>

      </div>
    </div>
  </nav>


  <!-- Main -->
  <main class="mx-auto max-w-4xl px-6 py-12">

    <!-- Back -->
    <%= link_to booking_path(@booking),
        class: "inline-flex items-center gap-2 text-sm text-gray-400 hover:text-white transition" do %>
      ← Back to Booking
    <% end %>


    <!-- Header -->
    <div class="mt-8">

      <p class="text-sm font-semibold uppercase tracking-wider text-red-500">
        Payment
      </p>

      <h1 class="mt-2 text-4xl font-bold">
        Complete Payment
      </h1>

      <p class="mt-3 text-gray-400">
        Complete your payment to confirm your seats.
      </p>

    </div>


    <!-- Payment Card -->
    <div class="mt-10 rounded-2xl border border-gray-800 bg-gray-900 p-8">

      <!-- Movie -->
      <div class="border-b border-gray-800 pb-6">

        <p class="text-xs uppercase tracking-wider text-gray-500">
          Movie
        </p>

        <h2 class="mt-2 text-2xl font-bold">
          <%= @booking.show.movie.title %>
        </h2>

      </div>


      <!-- Show Details -->
      <div class="grid gap-6 border-b border-gray-800 py-6 sm:grid-cols-2">

        <div>
          <p class="text-xs text-gray-500">
            Theatre
          </p>

          <p class="mt-1 font-semibold">
            <%= @booking.show.theatre.name %>
          </p>
        </div>


        <div>
          <p class="text-xs text-gray-500">
            Auditorium
          </p>

          <p class="mt-1 font-semibold">
            <%= @booking.show.auditorium.name %>
          </p>
        </div>


        <div>
          <p class="text-xs text-gray-500">
            Date
          </p>

          <p class="mt-1 font-semibold">
            <%= @booking.show.show_date.strftime("%d %B %Y") %>
          </p>
        </div>


        <div>
          <p class="text-xs text-gray-500">
            Showtime
          </p>

          <p class="mt-1 font-semibold">
            <%= @booking.show.start_time.strftime("%I:%M %p") %>
          </p>
        </div>

      </div>


      <!-- Seats -->
      <div class="border-b border-gray-800 py-6">

        <p class="text-xs text-gray-500">
          Selected Seats
        </p>

        <div class="mt-3 flex flex-wrap gap-2">

          <% @booking.booking_seats.each do |booking_seat| %>

            <% seat = booking_seat.show_seat.seat %>

            <span class="rounded-lg bg-red-600 px-3 py-2 text-sm font-semibold">
              <%= seat.row_name %><%= seat.seat_number %>
            </span>

          <% end %>

        </div>

      </div>


      <!-- Amount -->
      <div class="flex items-center justify-between py-6">

        <div>
          <p class="text-sm text-gray-500">
            Total Amount
          </p>

          <p class="mt-1 text-3xl font-bold text-green-400">
            ₹<%= number_with_precision(@payment.amount, precision: 2) %>
          </p>
        </div>

        <div class="text-right">

          <p class="text-xs text-gray-500">
            Payment Status
          </p>

          <span class="mt-2 inline-block rounded-full bg-yellow-500/10 px-3 py-1 text-xs font-semibold text-yellow-400">
            PENDING
          </span>

        </div>

      </div>


      <!-- Expiry -->
      <div class="rounded-xl border border-yellow-500/30 bg-yellow-500/5 p-5 text-center">

        <p class="text-sm text-gray-400">
          Seats held until
        </p>

        <p class="mt-2 text-xl font-bold text-yellow-400">
          <%= @booking.expires_at.strftime("%I:%M %p") %>
        </p>

        <p class="mt-1 text-xs text-gray-500">
          Complete payment before the hold expires.
        </p>

      </div>


      <!-- Payment Button -->
      <div class="mt-8">

        <%= form_with url: booking_payment_path(@booking),
                      method: :post,
                      local: true do %>

          <button
            type="submit"
            class="w-full rounded-xl bg-red-600 px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-red-600/20 transition hover:bg-red-700">

            Pay ₹<%= number_with_precision(@payment.amount, precision: 2) %>

          </button>

        <% end %>

      </div>

    </div>

  </main>

</div>