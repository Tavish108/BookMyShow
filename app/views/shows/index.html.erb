<div class="min-h-screen w-full bg-gray-950 text-white">
  <div class="mx-auto max-w-7xl px-6 py-12">

    <!-- Header -->
    <div class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-red-500">
          Show Management
        </p>

        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          All Shows
        </h1>

        <p class="mt-3 text-gray-400">
          Manage shows scheduled at your theatres.
        </p>
      </div>

      <%= link_to "Create Show",
          new_show_path,
          class: "inline-flex items-center justify-center rounded-lg bg-red-600 px-5 py-3 font-semibold text-white transition hover:bg-red-700" %>
    </div>

    <% if @shows.any? %>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">

        <% @shows.each do |show| %>

          <div class="rounded-2xl border border-gray-800 bg-gray-900 p-6">

            <!-- Movie -->
            <div class="mb-5">
              <p class="text-xs font-semibold uppercase tracking-wider text-red-500">
                Movie
              </p>

              <h2 class="mt-1 text-xl font-bold text-white">
                <%= show.movie.title %>
              </h2>
            </div>

            <!-- Theatre -->
            <div class="mb-4">
              <p class="text-sm text-gray-500">
                Theatre
              </p>

              <p class="mt-1 font-medium text-gray-200">
                <%= show.theatre.name %>
              </p>

              <p class="text-sm text-gray-400">
                <%= show.theatre.city %>
              </p>
            </div>

            <!-- Auditorium -->
            <div class="mb-4">
              <p class="text-sm text-gray-500">
                Auditorium
              </p>

              <p class="mt-1 font-medium text-gray-200">
                <%= show.auditorium.name %>
              </p>
            </div>

            <!-- Date & Time -->
            <div class="mb-4">
              <p class="text-sm text-gray-500">
                Date & Time
              </p>

              <p class="mt-1 font-medium text-gray-200">
                <%= show.show_date.strftime("%d %B %Y") %>
              </p>

              <p class="text-sm text-gray-400">
                <%= show.start_time.strftime("%I:%M %p") %>
                -
                <%= show.end_time.strftime("%I:%M %p") %>
              </p>
            </div>

            <!-- Price & Status -->
            <div class="mb-5 flex items-center justify-between">

              <div>
                <p class="text-sm text-gray-500">
                  Price
                </p>

                <p class="font-semibold text-white">
                  ₹<%= number_with_precision(show.price, precision: 2) %>
                </p>
              </div>

              <span class="rounded-full border border-gray-700 bg-gray-800 px-3 py-1 text-xs font-medium text-gray-300">
                <%= show.status %>
              </span>

            </div>

            <!-- Actions -->
            <div class="flex gap-3">

              <%= link_to "View",
                  show_path(show),
                  class: "flex-1 rounded-lg border border-gray-700 px-4 py-2 text-center text-sm font-medium text-gray-300 transition hover:bg-gray-800 hover:text-white" %>

              <%= link_to "Edit",
                  edit_show_path(show),
                  class: "flex-1 rounded-lg bg-gray-800 px-4 py-2 text-center text-sm font-medium text-white transition hover:bg-gray-700" %>

            </div>

          </div>

        <% end %>

      </div>

    <% else %>

      <div class="rounded-xl border border-dashed border-gray-700 bg-gray-900 px-6 py-12 text-center">

        <h2 class="text-xl font-semibold text-white">
          No shows yet
        </h2>

        <p class="mt-2 text-sm text-gray-400">
          You haven't created any shows yet.
        </p>

        <%= link_to "Create Your First Show",
            new_show_path,
            class: "mt-5 inline-flex rounded-lg bg-red-600 px-5 py-3 font-semibold text-white transition hover:bg-red-700" %>

      </div>

    <% end %>

  </div>
</div>