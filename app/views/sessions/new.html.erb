<div class="min-h-screen bg-gray-950 text-white">

  <!-- Navbar -->

  <nav class="border-b border-gray-800 bg-gray-900">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">


  <%= link_to "BookMyShow", root_path,
      class: "text-2xl font-bold tracking-tight text-red-500 hover:text-red-400 transition" %>

  <%= link_to "Register", register_path,
      class: "rounded-lg border border-gray-700 px-4 py-2 text-sm font-medium text-gray-300 transition hover:bg-gray-800 hover:text-white" %>

</div>


  </nav>

  <!-- Login Section -->

  <main class="flex min-h-[calc(100vh-73px)] items-center justify-center px-6 py-12">


<div class="w-full max-w-md">

  <!-- Login Card -->
  <div class="rounded-2xl border border-gray-800 bg-gray-900 p-8 shadow-2xl">

    <!-- Header -->
    <div class="mb-8 text-center">

      <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-red-600/10">
        <span class="text-2xl">🎬</span>
      </div>

      <h1 class="text-3xl font-bold tracking-tight">
        Welcome Back
      </h1>

      <p class="mt-2 text-sm text-gray-400">
        Login to continue to BookMyShow
      </p>

    </div>


    <!-- Flash Alert -->
    <% if flash[:alert] %>
      <div class="mb-6 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400">
        <%= flash[:alert] %>
      </div>
    <% end %>


    <!-- Login Form -->
    <%= form_with url: login_path, method: :post, class: "space-y-6" do |form| %>

      <!-- Email -->
      <div>
        <%= form.label :email,
            "Email Address",
            class: "mb-2 block text-sm font-medium text-gray-300" %>

        <%= form.email_field :email,
            placeholder: "you@example.com",
            autocomplete: "email",
            class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/20" %>
      </div>


      <!-- Password -->
      <div>
        <div class="mb-2 flex items-center justify-between">

          <%= form.label :password,
              "Password",
              class: "block text-sm font-medium text-gray-300" %>

        </div>

        <%= form.password_field :password,
            placeholder: "Enter your password",
            autocomplete: "current-password",
            class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/20" %>
      </div>


      <!-- Submit -->
      <div>
        <%= form.submit "Login",
            class: "w-full cursor-pointer rounded-lg bg-red-600 px-5 py-3 font-semibold text-white shadow-lg shadow-red-600/20 transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 focus:ring-offset-gray-900" %>
      </div>

    <% end %>


    <!-- Register -->
    <div class="mt-8 border-t border-gray-800 pt-6 text-center">

      <p class="text-sm text-gray-400">
        Don't have an account?

        <%= link_to "Register",
            register_path,
            class: "ml-1 font-semibold text-red-500 transition hover:text-red-400" %>
      </p>

    </div>

  </div>

  <!-- Back to Home -->
  <div class="mt-6 text-center">

    <%= link_to "← Back to Home",
        root_path,
        class: "text-sm text-gray-500 transition hover:text-gray-300" %>

  </div>

</div>


  </main>

</div>
