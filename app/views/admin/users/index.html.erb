<div class="min-h-screen w-full bg-gray-950 text-white">
  <div class="mx-auto w-full max-w-7xl px-6 py-12">

    <div class="mb-10 flex items-end justify-between">
      <div>
        <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-red-500">
          Administration
        </p>

        <h1 class="text-4xl font-bold tracking-tight">
          User Management
        </h1>

        <p class="mt-3 text-gray-400">
          Manage users and their assigned roles.
        </p>
      </div>

      <%= link_to "Dashboard",
          super_admin_dashboard_path,
          class: "rounded-lg border border-gray-700 px-5 py-3 font-medium text-gray-300 hover:bg-gray-800" %>
    </div>

    <div class="overflow-hidden rounded-2xl border border-gray-800 bg-gray-900">

      <div class="divide-y divide-gray-800">

        <% @users.each do |user| %>

          <div class="flex flex-col gap-5 px-6 py-6 sm:flex-row sm:items-center sm:justify-between">

            <div>
              <h2 class="text-lg font-semibold">
                <%= user.name %>
              </h2>

              <p class="mt-1 text-sm text-gray-400">
                <%= user.email %>
              </p>

              <div class="mt-3 flex flex-wrap gap-2">
                <% user.roles.each do |role| %>
                  <span class="rounded-full bg-red-500/10 px-3 py-1 text-xs font-medium text-red-400">
                    <%= role.name %>
                  </span>
                <% end %>
              </div>
            </div>

            <%= link_to "Manage Roles",
                edit_admin_user_path(user),
                class: "rounded-lg bg-red-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-red-700" %>

          </div>

        <% end %>

      </div>

    </div>

  </div>
</div>