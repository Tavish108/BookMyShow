<div class="min-h-screen w-full bg-gray-950 text-white">
  <div class="mx-auto max-w-3xl px-6 py-12">

    <div class="mb-8">
      <p class="text-sm font-semibold uppercase tracking-wider text-red-500">
        User Management
      </p>

      <h1 class="mt-2 text-4xl font-bold">
        Manage User
      </h1>

      <p class="mt-3 text-gray-400">
        <%= @user.name %> · <%= @user.email %>
      </p>
    </div>

    <div class="rounded-2xl border border-gray-800 bg-gray-900 p-6 sm:p-8">

      <%= form_with url: admin_user_path(@user),
          method: :patch do |form| %>

        <h2 class="text-lg font-semibold">
          Assign Roles
        </h2>

        <div class="mt-6 space-y-4">

          <% @roles.each do |role| %>

            <label class="flex cursor-pointer items-center gap-4 rounded-xl border border-gray-800 bg-gray-950 p-4 hover:bg-gray-800">

              <%= check_box_tag "role_ids[]",
                  role.id,
                  @user.roles.include?(role),
                  class: "h-5 w-5 rounded border-gray-700 bg-gray-900 text-red-600" %>

              <div>
                <p class="font-medium">
                  <%= role.name %>
                </p>

                <p class="text-sm text-gray-500">
                  Grant <%= role.name %> permissions
                </p>
              </div>

            </label>

          <% end %>

        </div>

        <div class="mt-8 flex gap-3">

          <%= link_to "Cancel",
              admin_users_path,
              class: "rounded-lg border border-gray-700 px-5 py-3 font-medium text-gray-300 hover:bg-gray-800" %>

          <%= form.submit "Save Permissions",
              class: "rounded-lg bg-red-600 px-5 py-3 font-semibold text-white hover:bg-red-700" %>

        </div>

      <% end %>

    </div>

  </div>
</div>