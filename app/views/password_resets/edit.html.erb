<div class="min-h-screen bg-gray-950 text-white">
  <main class="flex min-h-screen items-center justify-center px-6 py-12">
    <div class="w-full max-w-md">

      <div class="rounded-2xl border border-gray-800 bg-gray-900 p-8 shadow-2xl">

        <div class="mb-8 text-center">
          <h1 class="text-3xl font-bold">
            Reset Password
          </h1>

          <p class="mt-2 text-sm text-gray-400">
            Create a new password for your account.
          </p>
        </div>

        <% if flash[:alert] %>
          <div class="mb-6 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400">
            <%= flash[:alert] %>
          </div>
        <% end %>

        <%= form_with url: reset_password_path,
                      method: :patch,
                      class: "space-y-6" do |form| %>

          <div>
            <%= form.label :password,
                "New Password",
                class: "mb-2 block text-sm font-medium text-gray-300" %>

            <%= form.password_field :password,
                autocomplete: "new-password",
                placeholder: "Enter new password",
                class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white outline-none focus:border-red-500" %>
          </div>

          <div>
            <%= form.label :password_confirmation,
                "Confirm Password",
                class: "mb-2 block text-sm font-medium text-gray-300" %>

            <%= form.password_field :password_confirmation,
                autocomplete: "new-password",
                placeholder: "Confirm new password",
                class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white outline-none focus:border-red-500" %>
          </div>

          <%= form.submit "Reset Password",
              class: "w-full cursor-pointer rounded-lg bg-red-600 px-5 py-3 font-semibold text-white transition hover:bg-red-700" %>

        <% end %>

      </div>

    </div>
  </main>
</div>