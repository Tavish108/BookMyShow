<div class="min-h-screen bg-gray-950 text-white">
  <main class="flex min-h-screen items-center justify-center px-6 py-12">
    <div class="w-full max-w-md">

      <div class="rounded-2xl border border-gray-800 bg-gray-900 p-8 shadow-2xl">

        <div class="mb-8 text-center">
          <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-red-600/10">
            <span class="text-2xl">🔐</span>
          </div>

          <h1 class="text-3xl font-bold">
            Verify OTP
          </h1>

          <p class="mt-2 text-sm text-gray-400">
            Enter the OTP to continue.
          </p>
        </div>

        <% if flash[:alert] %>
          <div class="mb-6 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400">
            <%= flash[:alert] %>
          </div>
        <% end %>

        <% if flash[:notice] %>
          <div class="mb-6 rounded-lg border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-400">
            <%= flash[:notice] %>
          </div>
        <% end %>

        <%= form_with url: verify_password_reset_path,
                      method: :post,
                      class: "space-y-6" do |form| %>

          <div>
            <%= form.label :otp,
                "6-Digit OTP",
                class: "mb-2 block text-sm font-medium text-gray-300" %>

            <%= form.text_field :otp,
                maxlength: 6,
                inputmode: "numeric",
                autocomplete: "one-time-code",
                placeholder: "Enter OTP",
                class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-center tracking-[0.4em] text-white outline-none focus:border-red-500" %>
          </div>

          <%= form.submit "Verify OTP",
              class: "w-full cursor-pointer rounded-lg bg-red-600 px-5 py-3 font-semibold text-white transition hover:bg-red-700" %>
        <% end %>

      </div>

    </div>
  </main>
</div>