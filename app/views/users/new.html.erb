<div class="min-h-screen w-full bg-gray-950 text-white">
  <div class="flex min-h-screen items-center justify-center px-6 py-12">

    <!-- Fixed/appropriate form width -->
    <div class="w-full max-w-xl">

      <!-- Header -->
      <div class="mb-8 text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-red-500">
          BOOKMYSHOW
        </p>

        <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Create an Account
        </h1>

        <p class="mt-3 text-gray-400">
          Join BookMyShow and start discovering movies and shows.
        </p>
      </div>

      <!-- Registration Card -->
      <div class="rounded-2xl border border-gray-800 bg-gray-900 p-6 sm:p-8">

        <!-- Errors -->
        <% if @user.errors.any? %>
          <div class="mb-6 rounded-xl border border-red-500/30 bg-red-500/10 p-4">
            <div class="flex items-start gap-3">
              <span class="text-lg">⚠️</span>

              <div>
                <h2 class="text-sm font-semibold text-red-400">
                  <%= pluralize(@user.errors.count, "error") %> prevented registration:
                </h2>

                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-400">
                  <% @user.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Form -->
        <%= form_with model: @user, url: register_path, class: "space-y-6" do |form| %>

          <!-- Name -->
          <div>
            <%= form.label :name,
                class: "mb-2 block text-sm font-medium text-gray-300" %>

            <%= form.text_field :name,
                placeholder: "Enter your full name",
                class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white placeholder-gray-600 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/20" %>
          </div>

          <!-- Email -->
          <div>
            <%= form.label :email,
                class: "mb-2 block text-sm font-medium text-gray-300" %>

            <%= form.email_field :email,
                placeholder: "Enter your email address",
                class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white placeholder-gray-600 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/20" %>
          </div>

          <!-- Phone -->
          <div>
            <%= form.label :phone,
                class: "mb-2 block text-sm font-medium text-gray-300" %>

            <%= form.telephone_field :phone,
                placeholder: "Enter your phone number",
                class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white placeholder-gray-600 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/20" %>
          </div>

          <!-- Password -->
          <div>
            <%= form.label :password,
                class: "mb-2 block text-sm font-medium text-gray-300" %>

            <%= form.password_field :password,
                placeholder: "Create a password",
                class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white placeholder-gray-600 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/20" %>
          </div>

          <!-- Password Confirmation -->
          <div>
            <%= form.label :password_confirmation,
                class: "mb-2 block text-sm font-medium text-gray-300" %>

            <%= form.password_field :password_confirmation,
                placeholder: "Confirm your password",
                class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white placeholder-gray-600 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/20" %>
          </div>

          <!-- Register -->
          <div class="pt-2">
            <%= form.submit "Register",
                class: "w-full cursor-pointer rounded-lg bg-red-600 px-5 py-3 font-semibold text-white transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500/40" %>
          </div>

        <% end %>

        <!-- Login -->
        <div class="mt-6 border-t border-gray-800 pt-6 text-center">
          <p class="text-sm text-gray-400">
            Already have an account?

            <%= link_to "Login",
                login_path,
                class: "font-medium text-red-500 transition hover:text-red-400" %>
          </p>
        </div>

      </div>

      <p class="mt-6 text-center text-xs text-gray-500">
        Create your account to browse movies, find shows and book tickets.
      </p>

    </div>
  </div>
</div>