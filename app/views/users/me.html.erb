  <!-- Profile -->

  <main class="mx-auto max-w-4xl px-6 py-12">

```
<!-- Header -->
<div class="mb-10">

  <p class="text-sm font-semibold uppercase tracking-wider text-red-500">
    Account
  </p>

  <h1 class="mt-2 text-4xl font-bold tracking-tight">
    My Profile
  </h1>

  <p class="mt-3 text-gray-400">
    View your account information and assigned roles.
  </p>

</div>


<!-- Profile Card -->
<div class="overflow-hidden rounded-2xl border border-gray-800 bg-gray-900">

  <!-- Profile Header -->
  <div class="border-b border-gray-800 px-6 py-8 sm:px-8">

    <div class="flex items-center gap-5">

      <!-- Avatar -->
      <div class="flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-full bg-red-600 text-2xl font-bold text-white shadow-lg shadow-red-600/20">
        <%= current_user.name.first.upcase %>
      </div>

      <div>

        <h2 class="text-2xl font-bold">
          <%= current_user.name %>
        </h2>

        <p class="mt-1 text-sm text-gray-400">
          <%= current_user.email %>
        </p>

      </div>

    </div>

  </div>


  <!-- User Information -->
  <div class="px-6 py-8 sm:px-8">

    <h3 class="mb-6 text-lg font-semibold">
      Personal Information
    </h3>

    <div class="grid gap-6 sm:grid-cols-2">

      <!-- Name -->
      <div class="rounded-xl border border-gray-800 bg-gray-950 p-5">

        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
          Full Name
        </p>

        <p class="mt-2 text-base font-medium text-white">
          <%= current_user.name %>
        </p>

      </div>


      <!-- Email -->
      <div class="rounded-xl border border-gray-800 bg-gray-950 p-5">

        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
          Email Address
        </p>

        <p class="mt-2 break-all text-base font-medium text-white">
          <%= current_user.email %>
        </p>

      </div>


      <!-- Phone -->
      <div class="rounded-xl border border-gray-800 bg-gray-950 p-5">

        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
          Phone Number
        </p>

        <p class="mt-2 text-base font-medium text-white">
          <%= current_user.phone.presence || "Not provided" %>
        </p>

      </div>

    </div>

  </div>


  <!-- Roles -->
  <div class="border-t border-gray-800 px-6 py-8 sm:px-8">

    <h3 class="text-lg font-semibold">
      Roles & Permissions
    </h3>

    <p class="mt-1 text-sm text-gray-400">
      Roles assigned to your account.
    </p>


    <div class="mt-5 flex flex-wrap gap-3">

      <% current_user.roles.each do |role| %>

        <span class="inline-flex items-center rounded-full border border-red-500/30 bg-red-500/10 px-4 py-2 text-sm font-medium text-red-400">
          <span class="mr-2 h-2 w-2 rounded-full bg-red-500"></span>
          <%= role.name %>
        </span>

      <% end %>

    </div>

  </div>

</div>


<!-- Navigation -->
<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">

  <%= link_to root_path,
      class: "inline-flex items-center justify-center gap-2 rounded-lg border border-gray-700 px-5 py-2.5 text-sm font-medium text-gray-300 transition hover:bg-gray-800 hover:text-white" do %>

    ← Home

  <% end %>


  <%= link_to user_dashboard_path,
      class: "inline-flex items-center justify-center gap-2 rounded-lg bg-red-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-red-700" do %>

    Dashboard →

  <% end %>

</div>


<!-- Logout -->
<div class="mt-6 text-center">

  <%= button_to "Logout",
      logout_path,
      method: :delete,
      class: "text-sm font-medium text-gray-500 transition hover:text-red-400" %>

</div>
```

  </main>

</div>
