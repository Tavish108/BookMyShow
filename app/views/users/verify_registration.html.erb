<div class="min-h-screen bg-gray-950 text-white">
  <div class="flex min-h-screen items-center justify-center px-6 py-12">

    <div class="w-full max-w-md">

      <div class="rounded-2xl border border-gray-800 bg-gray-900 p-8 shadow-2xl">

        <div class="mb-8 text-center">
          <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-red-600/10">
            <span class="text-2xl">🔐</span>
          </div>

          <h1 class="text-3xl font-bold">
            Verify Your Account
          </h1>

          <p class="mt-2 text-sm text-gray-400">
            Enter the OTPs sent to your email and mobile number.
          </p>
        </div>

        <% if flash[:alert] %>
          <div class="mb-6 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400">
            <%= flash[:alert] %>
          </div>
        <% end %>

        <% if flash[:notice] %>
          <div class="mb-6 rounded-lg border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-400">
            <%= flash[:notice] %>
          </div>
        <% end %>

<%# timer %>

<div class="mt-4 text-center">

  <div id="otp-timer" class="text-sm text-gray-400">
    Resend OTP in
    <span
      id="countdown"
      class="font-semibold text-white"
      data-otp-sent-at="<%= @pending_registration.otp_sent_at.iso8601 %>"
    >
      2:00
    </span>
  </div>

  <div
    id="resend-message"
    class="hidden text-sm font-semibold text-green-400"
  >
    You can resend the OTP now.
  </div>

  <div id="resend-button" class="mt-3 hidden">
    <%= button_to "Resend OTP",
        resend_otp_path,
        method: :post,
        data: { turbo: false },
        class: "rounded-lg bg-red-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-red-700" %>
  </div>

</div>





        <%= form_with url: verify_registration_path,
                      method: :post,
                      class: "space-y-6" do |form| %>

          <div>
            <%= form.label :email_otp,
                "Email OTP",
                class: "mb-2 block text-sm font-medium text-gray-300" %>

            <%= form.text_field :email_otp,
                maxlength: 6,
                inputmode: "numeric",
                autocomplete: "one-time-code",
                placeholder: "Enter 6-digit email OTP",
                class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-center tracking-[0.4em] text-white placeholder-gray-600 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/20" %>
          </div>

       

          <div>
            <%= form.submit "Verify Account",
                class: "w-full cursor-pointer rounded-lg bg-red-600 px-5 py-3 font-semibold text-white transition hover:bg-red-700" %>
          </div>

        <% end %>

      </div>

    </div>
  </div>
</div>