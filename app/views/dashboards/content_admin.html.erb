<h1>Content Admin Dashboard</h1>

<h2>My Movies</h2>

<% if @movies.any? %>
  <% @movies.each do |movie| %>
    <div>
      <h3>
        <%= link_to movie.title, movie_path(movie) %>
      </h3>

      <p>
        Language: <%= movie.language.name %>
      </p>

      <p>
        Status: <%= movie.status %>
      </p>
    </div>
  <% end %>
<% else %>
  <p>You haven't added any movies yet.</p>
<% end %>

<%= link_to "Add Movie", new_movie_path %>