<div class="min-h-screen bg-gray-950 text-white">

  <!-- Navbar -->

  <nav class="border-b border-gray-800 bg-gray-900">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">


  <%= link_to "BookMyShow", root_path,
      class: "text-2xl font-bold tracking-tight text-red-500 transition hover:text-red-400" %>

  <div class="flex items-center gap-4">

    <span class="hidden text-sm text-gray-400 sm:block">
      Content Admin:
      <span class="font-medium text-white">
        <%= current_user.name %>
      </span>
    </span>

    <%= link_to "Profile", me_path,
        class: "rounded-lg px-4 py-2 text-sm font-medium text-gray-300 transition hover:bg-gray-800 hover:text-white" %>

    <%= button_to "Logout",
        logout_path,
        method: :delete,
        class: "rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-700" %>

  </div>

</div>


  </nav>

  <!-- Dashboard -->

  <main class="mx-auto max-w-7xl px-6 py-12">


<!-- Header -->
<div class="mb-10 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">

  <div>

    <p class="text-sm font-semibold uppercase tracking-wider text-red-500">
      Content Management
    </p>

    <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">
      Content Admin Dashboard
    </h1>

    <p class="mt-3 text-gray-400">
      Manage the movies you've added to BookMyShow.
    </p>

  </div>


  <!-- Add Movie -->
  <%= link_to new_movie_path,
      class: "inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-5 py-3 font-semibold text-white shadow-lg shadow-red-600/20 transition hover:bg-red-700" do %>

    <span class="text-lg">+</span>
    Add Movie

  <% end %>

</div>


<!-- Stats -->
<div class="mb-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">

  <!-- Total Movies -->
  <div class="rounded-2xl border border-gray-800 bg-gray-900 p-6">

    <p class="text-sm font-medium text-gray-400">
      My Movies
    </p>

    <p class="mt-2 text-3xl font-bold">
      <%= @movies.count %>
    </p>

    <p class="mt-1 text-xs text-gray-500">
      Movies added by you
    </p>

  </div>


  <!-- Published -->
  <div class="rounded-2xl border border-gray-800 bg-gray-900 p-6">

    <p class="text-sm font-medium text-gray-400">
      Published
    </p>

    <p class="mt-2 text-3xl font-bold text-green-400">
      <%= @movies.count { |movie| movie.status.to_s.downcase == "published" } %>
    </p>

    <p class="mt-1 text-xs text-gray-500">
      Currently published movies
    </p>

  </div>


  <!-- Drafts -->
  <div class="rounded-2xl border border-gray-800 bg-gray-900 p-6">

    <p class="text-sm font-medium text-gray-400">
      Drafts
    </p>

    <p class="mt-2 text-3xl font-bold text-yellow-400">
      <%= @movies.count { |movie| movie.status.to_s.downcase == "draft" } %>
    </p>

    <p class="mt-1 text-xs text-gray-500">
      Movies still being prepared
    </p>

  </div>

</div>


<!-- Movies Section -->
<div class="rounded-2xl border border-gray-800 bg-gray-900">

  <!-- Section Header -->
  <div class="flex items-center justify-between border-b border-gray-800 px-6 py-5 sm:px-8">

    <div>

      <h2 class="text-xl font-semibold">
        My Movies
      </h2>

      <p class="mt-1 text-sm text-gray-400">
        Movies created by your account.
      </p>

    </div>

    <span class="rounded-full bg-gray-800 px-3 py-1 text-xs font-medium text-gray-400">
      <%= @movies.count %> total
    </span>

  </div>


  <!-- Movie List -->
  <% if @movies.any? %>

    <div class="divide-y divide-gray-800">

      <% @movies.each do |movie| %>

        <div class="group p-6 transition hover:bg-gray-800/40 sm:px-8">

          <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">

            <!-- Movie Information -->
            <div class="flex items-start gap-4">

              <!-- Movie Icon -->
              <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-red-500/10 text-xl">
                🎬
              </div>

              <div>

                <h3 class="text-lg font-semibold">

                  <%= link_to movie.title,
                      movie_path(movie),
                      class: "transition hover:text-red-400" %>

                </h3>

                <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-gray-400">

                  <span>
                    Language:
                    <span class="text-gray-300">
                      <%= movie.language.name %>
                    </span>
                  </span>

                  <span class="text-gray-700">•</span>

                  <span>
                    ID:
                    <span class="text-gray-300">
                      #<%= movie.id %>
                    </span>
                  </span>

                </div>

              </div>

            </div>


            <!-- Status + Action -->
            <div class="flex items-center gap-4">

              <% status = movie.status.to_s.downcase %>

              <% if status == "published" %>

                <span class="rounded-full border border-green-500/30 bg-green-500/10 px-3 py-1 text-xs font-semibold text-green-400">
                  Published
                </span>

              <% elsif status == "draft" %>

                <span class="rounded-full border border-yellow-500/30 bg-yellow-500/10 px-3 py-1 text-xs font-semibold text-yellow-400">
                  Draft
                </span>

              <% else %>

                <span class="rounded-full border border-gray-700 bg-gray-800 px-3 py-1 text-xs font-semibold text-gray-400">
                  <%= movie.status %>
                </span>

              <% end %>


              <%= link_to movie_path(movie),
                  class: "rounded-lg border border-gray-700 px-4 py-2 text-sm font-medium text-gray-300 transition hover:border-gray-600 hover:bg-gray-800 hover:text-white" do %>

                View

              <% end %>

            </div>

          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <!-- Empty State -->
    <div class="px-6 py-16 text-center sm:px-8">

      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-gray-800 text-3xl">
        🎬
      </div>

      <h3 class="mt-5 text-xl font-semibold">
        No movies yet
      </h3>

      <p class="mx-auto mt-2 max-w-md text-sm text-gray-400">
        You haven't added any movies yet. Start by creating your first movie.
      </p>

      <%= link_to new_movie_path,
          class: "mt-6 inline-flex items-center gap-2 rounded-lg bg-red-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-red-700" do %>

        <span>+</span>
        Add Your First Movie

      <% end %>

    </div>

  <% end %>

</div>


<!-- Back -->
<div class="mt-8">

  <%= link_to root_path,
      class: "text-sm font-medium text-gray-500 transition hover:text-gray-300" do %>

    ← Back to Home

  <% end %>

</div>


  </main>

</div>
