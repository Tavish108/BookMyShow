<div class="min-h-screen bg-gray-950 text-white">

  <!-- Navbar -->
  <nav class="border-b border-gray-800 bg-gray-900">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">

      <%= link_to "BookMyShow",
          root_path,
          class: "text-2xl font-bold tracking-tight text-red-500 transition hover:text-red-400" %>

      <div class="flex items-center gap-4">

        <span class="hidden text-sm text-gray-400 sm:block">
          Hi,
          <span class="font-medium text-white">
            <%= current_user.name %>
          </span>
        </span>

        <%= link_to "My Profile",
            me_path,
            class: "rounded-lg px-4 py-2 text-sm font-medium text-gray-300 transition hover:bg-gray-800 hover:text-white" %>

        <%= button_to "Logout",
            logout_path,
            method: :delete,
            class: "rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-700" %>

      </div>
    </div>
  </nav>


  <!-- Main -->
  <main class="mx-auto max-w-6xl px-6 py-10">

    <!-- Back -->
    <%= link_to movie_path(@movie),
        class: "inline-flex items-center gap-2 text-sm text-gray-400 transition hover:text-white" do %>
      ← Back to Showtimes
    <% end %>


    <!-- Header -->
    <div class="mt-8">

      <p class="text-sm font-semibold uppercase tracking-wider text-red-500">
        Select Seats
      </p>

      <h1 class="mt-2 text-4xl font-bold">
        <%= @movie.title %>
      </h1>

      <div class="mt-4 flex flex-wrap gap-3 text-sm text-gray-400">

        <span>
          <%= @show.theatre.name %>
        </span>

        <span>•</span>

        <span>
          <%= @show.auditorium.name %>
        </span>

        <span>•</span>

        <span>
          <%= @show.show_date.strftime("%d %b %Y") %>
        </span>

        <span>•</span>

        <span>
          <%= @show.start_time.strftime("%I:%M %p") %>
        </span>

      </div>
    </div>


    <!-- Booking Form -->
    <%= form_with url: create_booking_path(show_id: @show.id),
                  method: :post,
                  local: true,
                  id: "booking-form" do %>


      <!-- Screen -->
      <div class="mt-12">

        <div class="mx-auto max-w-2xl">

          <div class="rounded-t-[50%] border-t-4 border-gray-500 pt-3 text-center">

            <span class="text-xs uppercase tracking-[0.3em] text-gray-500">
              Screen
            </span>

          </div>

        </div>

      </div>


      <!-- Seats -->
      <div class="mt-10">

        <% @show_seats.group_by { |show_seat| show_seat.seat.row_name }.each do |row_name, show_seats| %>

          <div class="mb-4 flex items-center justify-center gap-3">

            <!-- Row Label -->
            <div class="w-8 text-sm font-semibold text-gray-500">
              <%= row_name %>
            </div>


            <!-- Seats -->
            <div class="flex gap-2">

              <% show_seats.each do |show_seat| %>

                <% seat = show_seat.seat %>

                <% if show_seat.available? %>

                  <button
                    type="button"
                    class="seat-button flex h-10 w-10 items-center justify-center rounded-md border border-gray-700 bg-gray-900 text-xs font-semibold text-gray-300 transition hover:border-red-500 hover:bg-red-600 hover:text-white"
                    data-show-seat-id="<%= show_seat.id %>"
                    data-seat-label="<%= seat.row_name %><%= seat.seat_number %>">

                    <%= seat.row_name %><%= seat.seat_number %>

                  </button>

                <% else %>

                  <!-- Unavailable -->
                  <button
                    type="button"
                    disabled
                    class="flex h-10 w-10 cursor-not-allowed items-center justify-center rounded-md border border-gray-700 bg-gray-700 text-xs font-semibold text-gray-500">

                    <%= seat.row_name %><%= seat.seat_number %>

                  </button>

                <% end %>

              <% end %>

            </div>

          </div>

        <% end %>

      </div>


      <!-- Hidden Selected Seat Inputs -->
      <div id="selected-seat-inputs"></div>


      <!-- Selected Seats -->
      <div class="mt-10 text-center">

        <p class="text-sm text-gray-500">
          Selected Seats
        </p>

        <p
          id="selected-seats"
          class="mt-2 text-lg font-semibold text-white">
          None
        </p>

      </div>


      <!-- Total -->
      <div class="mt-6 text-center">

        <p class="text-sm text-gray-500">
          Ticket Price
        </p>

        <p
          id="total-price"
          class="mt-1 text-xl font-bold text-green-400">
          ₹0.00
        </p>

      </div>


      <!-- Legend -->
      <div class="mt-8 flex justify-center gap-8 text-sm text-gray-400">

        <div class="flex items-center gap-2">
          <span class="h-4 w-4 rounded border border-gray-700 bg-gray-900"></span>
          Available
        </div>

        <div class="flex items-center gap-2">
          <span class="h-4 w-4 rounded bg-red-600"></span>
          Selected
        </div>

        <div class="flex items-center gap-2">
          <span class="h-4 w-4 rounded bg-gray-700"></span>
          Unavailable
        </div>

      </div>


      <!-- Continue -->
      <div class="mt-12 flex justify-center">

        <button
          type="submit"
          id="continue-button"
          disabled
          class="rounded-xl bg-red-600 px-8 py-3 font-semibold text-white shadow-lg shadow-red-600/20 transition hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-50">

          Continue

        </button>

      </div>

    <% end %>

  </main>

</div>


<script>
  document.addEventListener("turbo:load", function () {
    const seatButtons = document.querySelectorAll(".seat-button");
    const continueButton = document.getElementById("continue-button");
    const selectedSeatsDisplay = document.getElementById("selected-seats");
    const selectedSeatInputs = document.getElementById("selected-seat-inputs");
    const totalPrice = document.getElementById("total-price");

    if (!seatButtons.length) {
      console.log("No seat buttons found");
      return;
    }

    if (!continueButton) {
      console.log("Continue button not found");
      return;
    }

    let selectedSeats = [];

    const ticketPrice = <%= @show.price.to_f %>;

    function updateBookingUI() {
      // Remove old hidden inputs
      selectedSeatInputs.innerHTML = "";

      // Create hidden input for every selected seat
      selectedSeats.forEach((seat) => {
        const input = document.createElement("input");

        input.type = "hidden";
        input.name = "show_seat_ids[]";
        input.value = seat.id;

        selectedSeatInputs.appendChild(input);
      });

      // Nothing selected
      if (selectedSeats.length === 0) {
        selectedSeatsDisplay.textContent = "None";
        continueButton.disabled = true;
        totalPrice.textContent = "₹0";
        return;
      }

      // Display selected seats
      selectedSeatsDisplay.textContent =
        selectedSeats.map((seat) => seat.label).join(", ");

      // Enable continue
      continueButton.disabled = false;

      // Calculate total
      const total = selectedSeats.length * ticketPrice;

      totalPrice.textContent = "₹" + total.toFixed(2);
    }

    seatButtons.forEach((button) => {
      button.addEventListener("click", function () {
        const showSeatId = this.dataset.showSeatId;
        const seatLabel = this.dataset.seatLabel;

        console.log("Clicked seat:", showSeatId, seatLabel);

        const existingSeat = selectedSeats.find(
          (seat) => seat.id === showSeatId
        );

        // UNSELECT
        if (existingSeat) {
          selectedSeats = selectedSeats.filter(
            (seat) => seat.id !== showSeatId
          );

          this.classList.remove(
            "bg-red-600",
            "border-red-500",
            "text-white"
          );

          this.classList.add(
            "bg-gray-900",
            "border-gray-700",
            "text-gray-300"
          );
        }

        // SELECT
        else {
          selectedSeats.push({
            id: showSeatId,
            label: seatLabel
          });

          this.classList.remove(
            "bg-gray-900",
            "border-gray-700",
            "text-gray-300"
          );

          this.classList.add(
            "bg-red-600",
            "border-red-500",
            "text-white"
          );
        }

        updateBookingUI();

        console.log("Selected seats:", selectedSeats);
      });
    });

    updateBookingUI();
  });
</script>