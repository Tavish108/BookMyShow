<div class="min-h-screen bg-gray-950 px-4 py-10 text-white sm:px-6 lg:px-8">

  <div class="mx-auto max-w-6xl">

    <!-- Header -->
    <div class="mb-8">

      <h1 class="text-3xl font-bold sm:text-4xl">
        My Bookings
      </h1>

      <p class="mt-2 text-gray-400">
        View your movie tickets and booking history.
      </p>

    </div>


    <% if @bookings.empty? %>

      <!-- Empty State -->
      <div class="rounded-2xl border border-gray-800 bg-gray-900 px-6 py-16 text-center">

        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-red-500/10">

          <svg
            class="h-8 w-8 text-red-500"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24">

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 7h16M4 7v13h16V7M8 7V5a4 4 0 018 0v2" />

          </svg>

        </div>

        <h2 class="mt-5 text-xl font-semibold">
          No bookings yet
        </h2>

        <p class="mt-2 text-gray-400">
          Your movie bookings will appear here.
        </p>

        <%= link_to "Browse Movies",
                    movies_path,
                    class: "mt-6 inline-flex rounded-xl bg-red-600 px-6 py-3 font-semibold text-white transition hover:bg-red-700" %>

      </div>


    <% else %>

      <!-- Booking List -->
      <div class="space-y-5">

        <% @bookings.each do |booking| %>

          <div class="overflow-hidden rounded-2xl border border-gray-800 bg-gray-900 shadow-xl">

            <div class="p-6">

              <!-- Top section -->
              <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">

                <div>

                  <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">
                    Movie
                  </p>

                  <h2 class="mt-1 text-2xl font-bold">
                    <%= booking.show.movie.title %>
                  </h2>

                </div>


                <!-- Status -->
                <% if booking.status == "CONFIRMED" %>

                  <span class="inline-flex w-fit items-center gap-2 rounded-full bg-green-500/10 px-3 py-1.5 text-sm font-semibold text-green-400">

                    <span class="h-2 w-2 rounded-full bg-green-400"></span>

                    Confirmed

                  </span>

                <% elsif booking.status == "PENDING" %>

                  <span class="inline-flex w-fit rounded-full bg-yellow-500/10 px-3 py-1.5 text-sm font-semibold text-yellow-400">
                    Payment Pending
                  </span>

                <% elsif booking.status == "EXPIRED" %>

                  <span class="inline-flex w-fit rounded-full bg-gray-500/10 px-3 py-1.5 text-sm font-semibold text-gray-400">
                    Expired
                  </span>

                <% else %>

                  <span class="inline-flex w-fit rounded-full bg-red-500/10 px-3 py-1.5 text-sm font-semibold text-red-400">
                    <%= booking.status.titleize %>
                  </span>

                <% end %>

              </div>


              <!-- Divider -->
              <div class="my-6 border-t border-gray-800"></div>


              <!-- Booking details -->
              <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

                <!-- Theatre -->
                <div>

                  <p class="text-xs uppercase tracking-wide text-gray-500">
                    Theatre
                  </p>

                  <p class="mt-1 font-semibold">
                    <%= booking.show.theatre.name %>
                  </p>

                </div>


                <!-- Auditorium -->
                <div>

                  <p class="text-xs uppercase tracking-wide text-gray-500">
                    Auditorium
                  </p>

                  <p class="mt-1 font-semibold">
                    <%= booking.show.auditorium.name %>
                  </p>

                </div>


                <!-- Seats -->
                <div>

                  <p class="text-xs uppercase tracking-wide text-gray-500">
                    Seats
                  </p>

                  <p class="mt-1 font-semibold">

                    <%= booking.booking_seats.map { |booking_seat|
                          seat = booking_seat.show_seat.seat
                          "#{seat.row_name}#{seat.seat_number}"
                        }.join(", ") %>

                  </p>

                </div>


                <!-- Amount -->
                <div>

                  <p class="text-xs uppercase tracking-wide text-gray-500">
                    Amount
                  </p>

                  <p class="mt-1 font-semibold">
                    ₹<%= number_with_precision(
                          booking.total_amount,
                          precision: 2
                        ) %>
                  </p>

                </div>

              </div>


              <!-- Bottom -->
              <div class="mt-6 flex flex-col gap-4 border-t border-gray-800 pt-6 sm:flex-row sm:items-center sm:justify-between">

                <div class="text-sm text-gray-400">

                  Booking #
                  <span class="font-mono text-gray-300">
                    <%= booking.id %>
                  </span>

                </div>


                <% if booking.ticket.present? %>

                  <%= link_to ticket_path(booking.ticket),
                              class: "inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-5 py-3 font-semibold text-white shadow-lg shadow-red-600/20 transition hover:bg-red-700" do %>

                    <svg
                      class="h-5 w-5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24">

                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M4 7h16M4 7v13h16V7M8 7V5a4 4 0 018 0v2" />

                    </svg>

                    View Ticket

                  <% end %>

                <% end %>

              </div>

            </div>

          </div>

        <% end %>

      </div>

    <% end %>

  </div>

</div>