<div class="min-h-screen w-full bg-gray-950 text-white">
  <div class="mx-auto w-full max-w-4xl px-6 py-12">

    <!-- Page Header -->
    <div class="mb-8">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-red-500">
        Theatre Administration
      </p>

      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Edit Theatre
      </h1>

      <p class="mt-3 text-gray-400">
        Update the theatre's information, contact details and status.
      </p>
    </div>

    <!-- Form Card -->
    <div class="rounded-2xl border border-gray-800 bg-gray-900 p-6 sm:p-8">

      <!-- Validation Errors -->
      <% if @theatre.errors.any? %>
        <div class="mb-8 rounded-xl border border-red-500/30 bg-red-500/10 p-4">
          <div class="flex items-start gap-3">
            <span class="text-lg">⚠️</span>

            <div>
              <h2 class="text-sm font-semibold text-red-400">
                <%= pluralize(@theatre.errors.count, "error") %>
                prevented this theatre from being saved:
              </h2>

              <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-400">
                <% @theatre.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>

      <%= form_with model: @theatre, class: "space-y-8" do |form| %>

        <!-- Basic Information -->
        <div>
          <div class="mb-5 border-b border-gray-800 pb-4">
            <h2 class="text-xl font-semibold text-white">
              Basic Information
            </h2>

            <p class="mt-1 text-sm text-gray-400">
              Update the theatre name and location details.
            </p>
          </div>

          <div class="grid gap-6 md:grid-cols-2">

            <!-- Name -->
            <div class="md:col-span-2">
              <%= form.label :name,
                  class: "mb-2 block text-sm font-medium text-gray-300" %>

              <%= form.text_field :name,
                  class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white placeholder-gray-600 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/20" %>
            </div>

            <!-- Address -->
            <div class="md:col-span-2">
              <%= form.label :address,
                  class: "mb-2 block text-sm font-medium text-gray-300" %>

              <%= form.text_field :address,
                  class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white placeholder-gray-600 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/20" %>
            </div>

            <!-- City -->
            <div>
              <%= form.label :city,
                  class: "mb-2 block text-sm font-medium text-gray-300" %>

              <%= form.text_field :city,
                  class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white placeholder-gray-600 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/20" %>
            </div>

            <!-- State -->
            <div>
              <%= form.label :state,
                  class: "mb-2 block text-sm font-medium text-gray-300" %>

              <%= form.text_field :state,
                  class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white placeholder-gray-600 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/20" %>
            </div>

            <!-- Postal Code -->
            <div>
              <%= form.label :postal_code,
                  class: "mb-2 block text-sm font-medium text-gray-300" %>

              <%= form.text_field :postal_code,
                  class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white placeholder-gray-600 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/20" %>
            </div>

          </div>
        </div>


        <!-- Contact Information -->
        <div>
          <div class="mb-5 border-b border-gray-800 pb-4">
            <h2 class="text-xl font-semibold text-white">
              Contact Information
            </h2>

            <p class="mt-1 text-sm text-gray-400">
              Update the theatre's contact information.
            </p>
          </div>

          <div class="grid gap-6 md:grid-cols-2">

            <!-- Phone -->
            <div>
              <%= form.label :phone,
                  class: "mb-2 block text-sm font-medium text-gray-300" %>

              <%= form.telephone_field :phone,
                  class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white placeholder-gray-600 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/20" %>
            </div>

            <!-- Email -->
            <div>
              <%= form.label :email,
                  class: "mb-2 block text-sm font-medium text-gray-300" %>

              <%= form.email_field :email,
                  class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white placeholder-gray-600 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/20" %>
            </div>

          </div>
        </div>


        <!-- Theatre Status -->
        <div>
          <div class="mb-5 border-b border-gray-800 pb-4">
            <h2 class="text-xl font-semibold text-white">
              Theatre Status
            </h2>

            <p class="mt-1 text-sm text-gray-400">
              Update the current status of this theatre.
            </p>
          </div>

          <div>
            <%= form.label :status,
                class: "mb-2 block text-sm font-medium text-gray-300" %>

            <%= form.select :status,
                Theatre::STATUSES,
                {},
                class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-4 py-3 text-white outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-500/20" %>
          </div>
        </div>


        <!-- Actions -->
        <div class="flex flex-col-reverse gap-3 border-t border-gray-800 pt-6 sm:flex-row sm:justify-end">

          <%= link_to "Back to Theatre",
              theatre_path(@theatre),
              class: "rounded-lg border border-gray-700 px-5 py-3 text-center font-medium text-gray-300 transition hover:bg-gray-800 hover:text-white" %>

          <%= form.submit "Update Theatre",
              class: "cursor-pointer rounded-lg bg-red-600 px-5 py-3 font-semibold text-white transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500/40" %>

        </div>

      <% end %>

    </div>

  </div>
</div>