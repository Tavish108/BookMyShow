  <!-- Main -->

  <main class="mx-auto max-w-7xl px-6 py-12">

```
<!-- Header -->
<div class="mb-10">

  <p class="text-sm font-semibold uppercase tracking-wider text-red-500">
    Explore
  </p>

  <div class="mt-2 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">

    <div>

      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        Movies
      </h1>

      <p class="mt-3 text-gray-400">
        Discover movies currently available on BookMyShow.
      </p>

    </div>

    <div class="rounded-full bg-gray-900 px-4 py-2 text-sm text-gray-400">
      <%= @movies.count %> movies
    </div>

  </div>

</div>


<% if @movies.any? %>

  <!-- Movie Grid -->
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

    <% @movies.each do |movie| %>

      <div class="group overflow-hidden rounded-2xl border border-gray-800 bg-gray-900 transition duration-300 hover:-translate-y-1 hover:border-gray-700 hover:shadow-2xl">

        <!-- Poster -->
        <div class="relative aspect-[2/3] overflow-hidden bg-gray-800">

          <% if movie.poster_url.present? %>

            <img
              src="<%= movie.poster_url %>"
              alt="<%= movie.title %> poster"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105">

          <% else %>

            <div class="flex h-full items-center justify-center bg-gray-800">

              <div class="text-center">

                <div class="text-5xl">
                  🎬
                </div>

                <p class="mt-3 text-sm text-gray-500">
                  No poster available
                </p>

              </div>

            </div>

          <% end %>


          <!-- Status -->
          <div class="absolute left-3 top-3">

            <% if movie.status.to_s.upcase == "PUBLISHED" %>

              <span class="rounded-full bg-green-500/90 px-3 py-1 text-xs font-semibold text-white backdrop-blur">
                Published
              </span>

            <% elsif movie.status.to_s.upcase == "DRAFT" %>

              <span class="rounded-full bg-yellow-500/90 px-3 py-1 text-xs font-semibold text-black backdrop-blur">
                Draft
              </span>

            <% else %>

              <span class="rounded-full bg-gray-900/90 px-3 py-1 text-xs font-semibold text-gray-300 backdrop-blur">
                <%= movie.status %>
              </span>

            <% end %>

          </div>


          <!-- Certificate -->
          <div class="absolute right-3 top-3">

            <span class="rounded-md bg-black/70 px-2 py-1 text-xs font-semibold text-white backdrop-blur">
              <%= movie.certificate %>
            </span>

          </div>

        </div>


        <!-- Movie Details -->
        <div class="p-5">

          <h2 class="line-clamp-1 text-xl font-bold">

            <%= link_to movie.title,
                movie_path(movie),
                class: "transition hover:text-red-400" %>

          </h2>


          <!-- Language -->
          <div class="mt-3 flex items-center gap-2 text-sm text-gray-400">

            <span>🌐</span>

            <span>
              <%= movie.language.name %>
            </span>

          </div>


          <!-- Duration -->
          <div class="mt-2 flex items-center gap-2 text-sm text-gray-400">

            <span>⏱️</span>

            <span>
              <%= movie.duration_minutes %> minutes
            </span>

          </div>


          <!-- Genres -->
          <div class="mt-4 flex flex-wrap gap-2">

            <% movie.genres.each do |genre| %>

              <span class="rounded-full bg-gray-800 px-2.5 py-1 text-xs font-medium text-gray-400">
                <%= genre.name %>
              </span>

            <% end %>

          </div>


          <!-- Actions -->
          <div class="mt-5 flex items-center gap-3">

            <%= link_to "View Movie",
                movie_path(movie),
                class: "flex-1 rounded-lg bg-red-600 px-4 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-red-700" %>


            <% if current_user.has_role?("SUPER_ADMIN") ||
                  movie.created_by_id == current_user.id %>

              <%= link_to "Edit",
                  edit_movie_path(movie),
                  class: "rounded-lg border border-gray-700 px-4 py-2.5 text-sm font-medium text-gray-300 transition hover:bg-gray-800 hover:text-white" %>

            <% end %>

          </div>

        </div>

      </div>

    <% end %>

  </div>


<% else %>

  <!-- Empty State -->
  <div class="rounded-2xl border border-gray-800 bg-gray-900 px-6 py-20 text-center">

    <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-gray-800 text-4xl">
      🎬
    </div>

    <h2 class="mt-6 text-2xl font-bold">
      No Movies Available
    </h2>

    <p class="mx-auto mt-2 max-w-md text-gray-400">
      There are currently no movies available to browse.
      Check back later for new releases.
    </p>

    <%= link_to "Back to Dashboard",
        user_dashboard_path,
        class: "mt-6 inline-flex rounded-lg bg-red-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-red-700" %>

  </div>

<% end %>


<!-- Bottom Navigation -->
<div class="mt-10">

  <%= link_to "← Back to Dashboard",
      user_dashboard_path,
      class: "text-sm font-medium text-gray-500 transition hover:text-gray-300" %>

</div>
```

  </main>

</div>
