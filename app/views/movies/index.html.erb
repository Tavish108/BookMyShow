<div class="min-h-screen bg-gray-950 text-white">

  <!-- Navbar -->
  <nav class="border-b border-gray-800 bg-gray-900">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">

      <%= link_to "BookMyShow",
          root_path,
          class: "text-2xl font-bold tracking-tight text-red-500 hover:text-red-400 transition" %>

      <div class="flex items-center gap-4">

        <span class="hidden text-sm text-gray-400 sm:block">
          Hi,
          <span class="font-medium text-white">
            <%= current_user.name %>
          </span>
        </span>

        <%= link_to "My Profile",
            me_path,
            class: "rounded-lg px-4 py-2 text-sm font-medium text-gray-300 transition hover:bg-gray-800 hover:text-white" %>

        <%= button_to "Logout",
            logout_path,
            method: :delete,
            class: "rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-700" %>

      </div>
    </div>
  </nav>


  <!-- Main -->
  <main class="mx-auto max-w-7xl px-6 py-12">

    <!-- Header -->
    <div class="mb-8">
      <p class="text-sm font-semibold uppercase tracking-wider text-red-500">
        Movies
      </p>

      <h1 class="mt-2 text-4xl font-bold tracking-tight">
        Discover Movies
      </h1>

      <p class="mt-3 text-gray-400">
        Find your next movie and book your seats.
      </p>
    </div>


    <!-- Search -->
    <div class="mb-10">

      <%= form_with url: movies_path,
          method: :get,
          local: true,
          class: "flex flex-col gap-3 sm:flex-row" do |form| %>

        <%= form.text_field :search,
            value: params[:search],
            placeholder: "Search movies...",
            class: "w-full rounded-xl border border-gray-700 bg-gray-900 px-5 py-3 text-white placeholder-gray-500 outline-none transition focus:border-red-500 sm:flex-1" %>

        <%= form.submit "Search",
            class: "rounded-xl bg-red-600 px-6 py-3 font-semibold text-white transition hover:bg-red-700" %>

      <% end %>

    </div>


    <!-- Movies -->
    <% if @movies.any? %>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

        <% @movies.each do |movie| %>

          <%= link_to movie_path(movie),
              class: "group overflow-hidden rounded-2xl border border-gray-800 bg-gray-900 transition hover:-translate-y-1 hover:border-gray-700 hover:bg-gray-800" do %>

            <!-- Poster -->
            <div class="aspect-[2/3] overflow-hidden bg-gray-800">

              <% if movie.poster_url.present? %>

                <%= image_tag movie.poster_url,
                    alt: movie.title,
                    class: "h-full w-full object-cover transition duration-300 group-hover:scale-105" %>

              <% else %>

                <div class="flex h-full items-center justify-center text-gray-600">
                  No Poster
                </div>

              <% end %>

            </div>


            <!-- Movie Info -->
            <div class="p-5">

              <h2 class="text-xl font-semibold text-white">
                <%= movie.title %>
              </h2>

              <% if movie.language.present? %>
                <p class="mt-2 text-sm text-gray-400">
                  <%= movie.language.name %>
                </p>
              <% end %>

              <% if movie.duration_minutes.present? %>
                <p class="mt-1 text-sm text-gray-500">
                  <%= movie.duration_minutes %> minutes
                </p>
              <% end %>

              <div class="mt-4 text-sm font-semibold text-red-500">
                View Shows →
              </div>

            </div>

          <% end %>

        <% end %>

      </div>

    <% else %>

      <!-- Empty State -->
      <div class="rounded-2xl border border-gray-800 bg-gray-900 p-12 text-center">

        <div class="text-5xl">
          🎬
        </div>

        <h2 class="mt-5 text-2xl font-bold">
          No movies found
        </h2>

        <p class="mt-2 text-gray-400">
          Try searching with a different movie name.
        </p>

      </div>

    <% end %>

  </main>

</div>