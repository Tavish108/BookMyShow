<h1>Seats</h1>

<p>
  <strong>Theatre:</strong>
  <%= @theatre.name %>
</p>

<p>
  <strong>Auditorium:</strong>
  <%= @auditorium.name %>
</p>

<% if @seats.any? %>
  <table>
    <thead>
      <tr>
        <th>Seat</th>
        <th>Type</th>
        <th>Category</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @seats.each do |seat| %>
        <tr>
          <td><%= seat.row_name %><%= seat.seat_number %></td>
          <td><%= seat.seat_type %></td>
          <td><%= seat.seat_category %></td>
          <td>
            <%= link_to "View",
                        theatre_auditorium_seat_path(
                          @theatre,
                          @auditorium,
                          seat
                        ) %>

            <%= link_to "Edit",
                        edit_theatre_auditorium_seat_path(
                          @theatre,
                          @auditorium,
                          seat
                        ) %>

            <%= button_to "Delete",
                          theatre_auditorium_seat_path(
                            @theatre,
                            @auditorium,
                            seat
                          ),
                          method: :delete,
                          data: { turbo_confirm: "Are you sure?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No seats have been added yet.</p>
<% end %>

<p>
  <%= link_to "Add Seat",
              new_theatre_auditorium_seat_path(
                @theatre,
                @auditorium
              ) %>
</p>

<p>
  <%= link_to "Back to Auditorium",
              theatre_auditorium_path(
                @theatre,
                @auditorium
              ) %>
</p>