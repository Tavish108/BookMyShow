<div class="min-h-screen w-full bg-gray-950 text-white">
  <div class="mx-auto w-full max-w-7xl px-6 py-12">

    <!-- Page Header -->
    <div class="mb-8 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">

      <div>
        <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-red-500">
          Theatre Infrastructure
        </p>

        <h1 class="text-4xl font-bold tracking-tight text-white">
          Seats
        </h1>

        <p class="mt-3 text-gray-400">
          Manage seats for
          <span class="font-medium text-gray-300"><%= @auditorium.name %></span>
          at
          <span class="font-medium text-gray-300"><%= @theatre.name %></span>.
        </p>
      </div>

      <!-- Add Seat -->
      <%= link_to "Add Seat",
          new_theatre_auditorium_seat_path(
            @theatre,
            @auditorium
          ),
          class: "inline-flex w-full items-center justify-center rounded-lg bg-red-600 px-5 py-3 font-semibold text-white transition hover:bg-red-700 sm:w-auto" %>

    </div>


    <!-- Context Information -->
    <div class="mb-8 grid gap-4 sm:grid-cols-2">

      <!-- Theatre -->
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-4">
        <div class="flex items-center gap-3">

          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-red-500/10 text-lg">
            🎭
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
              Theatre
            </p>

            <p class="mt-1 font-medium text-white">
              <%= @theatre.name %>
            </p>
          </div>

        </div>
      </div>


      <!-- Auditorium -->
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-4">
        <div class="flex items-center gap-3">

          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-red-500/10 text-lg">
            🎬
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
              Auditorium
            </p>

            <p class="mt-1 font-medium text-white">
              <%= @auditorium.name %>
            </p>
          </div>

        </div>
      </div>

    </div>


    <% if @seats.any? %>

      <!-- Seats Table -->
      <div class="overflow-hidden rounded-2xl border border-gray-800 bg-gray-900">

        <div class="border-b border-gray-800 px-6 py-5">
          <h2 class="text-xl font-semibold text-white">
            Seat List
          </h2>

          <p class="mt-1 text-sm text-gray-400">
            View and manage all seats in this auditorium.
          </p>
        </div>


        <!-- Responsive Table -->
        <div class="overflow-x-auto">

          <table class="w-full min-w-[700px] text-left">

            <thead class="border-b border-gray-800 bg-gray-950">
              <tr>
                <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-gray-500">
                  Seat
                </th>

                <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-gray-500">
                  Type
                </th>

                <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-gray-500">
                  Category
                </th>

                <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">
                  Actions
                </th>
              </tr>
            </thead>


            <tbody class="divide-y divide-gray-800">

              <% @seats.each do |seat| %>

                <tr class="transition hover:bg-gray-800/60">

                  <!-- Seat -->
                  <td class="whitespace-nowrap px-6 py-5">

                    <div class="flex items-center gap-3">

                      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-gray-800">
                        💺
                      </div>

                      <div>
                        <p class="font-semibold text-white">
                          <%= seat.row_name %><%= seat.seat_number %>
                        </p>

                        <p class="text-xs text-gray-500">
                          Seat
                        </p>
                      </div>

                    </div>

                  </td>


                  <!-- Type -->
                  <td class="whitespace-nowrap px-6 py-5">

                    <span class="rounded-full border border-gray-700 bg-gray-950 px-3 py-1 text-sm text-gray-300">
                      <%= seat.seat_type %>
                    </span>

                  </td>


                  <!-- Category -->
                  <td class="whitespace-nowrap px-6 py-5">

                    <span class="rounded-full border border-gray-700 bg-gray-950 px-3 py-1 text-sm text-gray-300">
                      <%= seat.seat_category %>
                    </span>

                  </td>


                  <!-- Actions -->
                  <td class="px-6 py-5">

                    <div class="flex justify-end gap-2">

                      <%= link_to "View",
                          theatre_auditorium_seat_path(
                            @theatre,
                            @auditorium,
                            seat
                          ),
                          class: "rounded-lg border border-gray-700 px-3 py-2 text-sm font-medium text-gray-300 transition hover:bg-gray-800 hover:text-white" %>

                      <%= link_to "Edit",
                          edit_theatre_auditorium_seat_path(
                            @theatre,
                            @auditorium,
                            seat
                          ),
                          class: "rounded-lg border border-gray-700 px-3 py-2 text-sm font-medium text-gray-300 transition hover:bg-gray-800 hover:text-white" %>

                      <%= button_to "Delete",
                          theatre_auditorium_seat_path(
                            @theatre,
                            @auditorium,
                            seat
                          ),
                          method: :delete,
                          data: { turbo_confirm: "Are you sure?" },
                          class: "rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm font-medium text-red-400 transition hover:bg-red-500/20" %>

                    </div>

                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      </div>


    <% else %>

      <!-- Empty State -->
      <div class="flex min-h-[400px] items-center justify-center rounded-2xl border border-gray-800 bg-gray-900 p-8">

        <div class="max-w-md text-center">

          <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-gray-800 text-2xl">
            💺
          </div>

          <h2 class="text-2xl font-bold text-white">
            No Seats Available
          </h2>

          <p class="mt-3 text-gray-400">
            No seats have been added to
            <span class="text-gray-300"><%= @auditorium.name %></span>
            yet.
          </p>

          <div class="mt-6">

            <%= link_to "Add Seat",
                new_theatre_auditorium_seat_path(
                  @theatre,
                  @auditorium
                ),
                class: "inline-flex rounded-lg bg-red-600 px-5 py-3 font-semibold text-white transition hover:bg-red-700" %>

          </div>

        </div>

      </div>

    <% end %>


    <!-- Back -->
    <div class="mt-8">

      <%= link_to "← Back to Auditorium",
          theatre_auditorium_path(
            @theatre,
            @auditorium
          ),
          class: "text-sm font-medium text-gray-400 transition hover:text-white" %>

    </div>

  </div>
</div>